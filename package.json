{
  "name": "loopdrop",
  "version": "0.1.0",
  "description": "Private, on-device video-to-GIF desktop app, CLI, and MCP server",
  "author": "Ibai Gorordo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibaiGorordo/loopdrop.git"
  },
  "homepage": "https://github.com/ibaiGorordo/loopdrop#readme",
  "bugs": {
    "url": "https://github.com/ibaiGorordo/loopdrop/issues"
  },
  "type": "module",
  "main": "core/index.cjs",
  "exports": {
    ".": "./core/index.cjs",
    "./core": "./core/index.cjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "loopdrop": "cli/loopdrop.mjs",
    "loopdrop-mcp": "mcp/server.mjs"
  },
  "files": [
    "cli/**/*",
    "core/**/*",
    "mcp/**/*",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gif",
    "video",
    "ffmpeg",
    "electron",
    "cli",
    "mcp"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs\"",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run build && npm test",
    "start": "electron electron/main.cjs",
    "cli": "node cli/loopdrop.mjs",
    "mcp": "node mcp/server.mjs",
    "ffmpeg:build": "./scripts/build-ffmpeg-unix.sh",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "electron-updater": "6.8.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/get": "5.1.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  },
  "overrides": {
    "@electron/asar": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    },
    "@electron/get": {
      "undici": "7.29.0"
    },
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "io.github.ibaigorordo.loopdrop",
    "productName": "Loopdrop",
    "executableName": "loopdrop",
    "artifactName": "loopdrop-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "package.json",
      "!node_modules/@modelcontextprotocol/**/*",
      "!node_modules/zod/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg/current",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "ffprobe",
          "ffprobe.exe",
          "COPYING.LGPLv2.1",
          "FFMPEG-LICENSE.md",
          "build-configuration.txt",
          "version.txt"
        ]
      },
      {
        "from": "build-resources",
        "to": "tray",
        "filter": [
          "trayTemplate.png",
          "trayTemplate@2x.png"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ibaiGorordo",
        "repo": "loopdrop",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "avi",
          "m4v",
          "mkv",
          "mov",
          "mp4",
          "mpeg",
          "mpg",
          "ogv",
          "webm",
          "wmv"
        ],
        "name": "Video",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build-resources/icon.icns",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "category": "AudioVideo",
      "maintainer": "Ibai Gorordo",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
